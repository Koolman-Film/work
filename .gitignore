# macOS
.DS_Store
.AppleDouble
.LSOverride

# Editor / IDE
.vscode/
.idea/
*.swp
*.swo
*~

# Claude
.claude/settings.local.json
.claude/.credentials.json
.claude/worktrees/

# Node (when impl starts)
node_modules/
.next/
.turbo/
dist/
build/
*.log
.env
.env.local
.env.*.local
.env.local.*
!.env.example

# Local credential / secret docs — never commit
*.local.md
credentials.local.*

# Python (for tooling scripts)
__pycache__/
*.pyc
.venv/
venv/

# Generated artifacts (regenerable from source mockups)
docs/v1/screens/mockups/screenshots/

# Generated docx/pdf — regenerable from build script
docs/v1/Koolman_HR_Mockup_Walkthrough.docx
docs/v1/Koolman_HR_Mockup_Walkthrough.pdf

# Temp
/tmp/
*.tmp

# Next.js build artifacts
.next/
out/
# Generated by `next dev`/`next build`/`next typegen` — content differs
# between dev and build, so tracking it churns the tree forever. The
# `typecheck` script regenerates it via `next typegen` before tsc.
next-env.d.ts
next-env.d.ts.bak
*.tsbuildinfo

# Playwright artifacts
test-results/
playwright-report/
blob-report/
playwright/.cache/
.superpowers/

# MCP browser captures + ad-hoc dev screenshots (repo root only)
.playwright-mcp/
/*.png
# Ad-hoc PDFs dropped at the repo root (sample slips, user-shared docs) — never
# part of the project; mirrors the root-PNG rule above.
/*.pdf

# Local dev artifacts that live untracked in the tree — keep them out of
# commits so a stray `git add -A` can't sweep them in.
.claude/launch.json
/payslip-samples/
/scripts/sample-payslip-pdf.mjs

# Supabase CLI local scaffolding (untracked dev state, not part of the project)
# — except config.toml, which CI needs to `supabase start` for the e2e job.
# It declares ports and feature flags only; every credential in it is an
# `env(...)` reference, never a literal.
supabase/*
!supabase/config.toml

# Vitest coverage output
/coverage
.vercel
.env.production
.env.*.production

# Analysis that quotes real production data — names, salaries, health/leave
# details, admin addresses. Kept on disk for whoever is working the case, never
# committed: this repository is PUBLIC, and once such a file is pushed the data
# stays reachable by commit SHA even after a history rewrite.
# Write committed docs against pseudonyms instead (EMP-A, admin-1@example.invalid).
docs/private/
